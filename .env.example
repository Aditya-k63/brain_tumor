# Brain Tumor MRI Classifier - Environment Variables

# Model path (local) or HuggingFace repo ID
MODEL_PATH=model/brain_tumor_final.h5
HF_REPO_ID=neuronsbyisshu/brain-tumor-model

# Minimum confidence threshold (0.0 - 1.0)
# Predictions below this are flagged as low-confidence
MIN_CONFIDENCE=0.40

# Server port
PORT=8000

# Streamlit API URL (used by app.py)
API_URL=http://localhost:8000
